{
  "name": "dorc-web",
  "version": "1.0.0",
  "private": true,
  "description": "Web UI for DOrc",
  "type": "module",
  "author": "SEFE",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "build": "npm run audit:renderers && eslint && tsc && npm run typecheck:tests && vite build",
    "buildLocal": "set NODE_OPTIONS=--openssl-legacy-provider && rimraf server/dist/ && rollup --config",
    "api-gen": "npm run dorc-api-gen && npm run ado-build-csharp-gen",
    "dorc-api-gen": "openapi-generator-cli --openapitools ./src/apis/dorc-api/openapitools.json generate -g typescript-rxjs -i ./src/apis/dorc-api/swagger.json -o ./src/apis/dorc-api/ --additional-properties=supportsES6=true,npmVersion=9.4.0,typescriptThreePlus=true --skip-validate-spec",
    "ado-build-csharp-gen": "openapi-generator-cli --openapitools ../Dorc.AzureDevOps/openapitools.json generate -g csharp -i ../Dorc.AzureDevOps/build.json -o ../Dorc.AzureDevOps --library restsharp --additional-properties=targetFramework=net8.0,nullableReferenceTypes=true,packageGuid={45A98C2E-0629-4B20-9B7F-450B0F9AE8ED} --skip-validate-spec",
    "ado-build-spec-refresh": "node scripts/fetch-ado-build-spec.mjs",
    "format": "prettier \"**/*.ts\" --write --ignore-path .gitignore --ignore-path .prettierignore",
    "lit:type-checking": "lit-analyzer \"src/{components,pages}/**/*.ts\" --strict",
    "dev": "vite",
    "preview": "vite preview",
    "start": "npm run serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "type-checking": "tsc --noEmit && npm run typecheck:tests && npm run lit:type-checking",
    "prepare": "husky",
    "audit:renderers": "node tools/gate-check.mjs && node tools/renderer-audit.mjs --check && node tools/renderer-deps.mjs && node tools/confirm-prompt-snapshot.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/ace": "^0.0.52",
    "@types/google.visualization": "^0.0.75",
    "@types/yaireo__tagify": "^4.27.0",
    "@vaadin/button": "^25.3.4",
    "@vaadin/checkbox": "^25.3.4",
    "@vaadin/combo-box": "^25.3.4",
    "@vaadin/confirm-dialog": "^25.3.4",
    "@vaadin/date-picker": "^25.3.4",
    "@vaadin/date-time-picker": "^25.3.4",
    "@vaadin/details": "^25.3.4",
    "@vaadin/dialog": "^25.0.0",
    "@vaadin/grid": "^25.3.4",
    "@vaadin/horizontal-layout": "^25.3.4",
    "@vaadin/icon": "^25.3.4",
    "@vaadin/icons": "^25.3.4",
    "@vaadin/item": "^25.0.0",
    "@vaadin/list-box": "^25.3.4",
    "@vaadin/notification": "^25.3.4",
    "@vaadin/number-field": "^25.3.4",
    "@vaadin/password-field": "^25.3.4",
    "@vaadin/radio-group": "^25.3.4",
    "@vaadin/tabs": "^25.3.4",
    "@vaadin/text-area": "^25.3.4",
    "@vaadin/text-field": "^25.0.0",
    "@vaadin/tooltip": "^25.3.4",
    "@vaadin/vaadin-lumo-styles": "^25.3.4",
    "@vaadin/vaadin-themable-mixin": "^25.0.0",
    "@vaadin/vertical-layout": "^25.3.4",
    "@yaireo/tagify": "^4.39.0",
    "ace-builds": "^1.45.2",
    "echarts": "^6.1.0",
    "lit": "^3.3.3",
    "oidc-client-ts": "^3.5.0",
    "pwa-helper-components": "~0.2.10",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "universal-router": "^10.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.3",
    "chai": "^6.2.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.3",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lit-analyzer": "^2.0.3",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.0",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}

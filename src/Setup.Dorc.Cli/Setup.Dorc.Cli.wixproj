<Project>
  <Import Project="Sdk.props" Sdk="WixToolset.Sdk" Version="6.0.1" />
  <PropertyGroup>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <Name>Setup.Dorc.Cli</Name>
    <ToolsDCEBDir>$(SolutionDir)Tools.DeployCopyEnvBuildCLI\bin\$(Configuration)\net8.0\publish</ToolsDCEBDir>
    <ToolsPREDir>$(SolutionDir)Tools.PostRestoreEndurCLI\bin\$(Configuration)\net8.0\publish</ToolsPREDir>
    <ToolsPVCDir>$(SolutionDir)Tools.PropertyValueCreationCLI\bin\$(Configuration)\net8.0\publish</ToolsPVCDir>
    <ToolsReqDir>$(SolutionDir)Tools.RequestCLI\bin\$(Configuration)\net8.0\publish</ToolsReqDir>
    <ToolsEMDir>$(SolutionDir)Tools.EncryptionMigrationCLI\bin\$(Configuration)\net8.0\publish</ToolsEMDir>
    <Platforms>x64</Platforms>
    <!-- See the equivalent property in Setup.Dorc.wixproj for the reasoning. -->
    <DorcProductVersion Condition="'$(Version)' != ''">$([System.Version]::Parse('$(Version)').ToString())</DorcProductVersion>
    <DorcProductVersion Condition="'$(DorcProductVersion)' == ''">0.0.1</DorcProductVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DefineConstants>Debug;ToolsDCEBDir=$(ToolsDCEBDir);ToolsPREDir=$(ToolsPREDir);ToolsPVCDir=$(ToolsPVCDir);ToolsReqDir=$(ToolsReqDir);ToolsEMDir=$(ToolsEMDir);BuildVersion=$(DorcProductVersion)</DefineConstants>
    <SuppressValidation>True</SuppressValidation>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DefineConstants>ToolsDCEBDir=$(ToolsDCEBDir);ToolsPREDir=$(ToolsPREDir);ToolsPVCDir=$(ToolsPVCDir);ToolsReqDir=$(ToolsReqDir);ToolsEMDir=$(ToolsEMDir);BuildVersion=$(DorcProductVersion)</DefineConstants>
    <SuppressValidation>True</SuppressValidation>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Dependencies.wxi" />
    <Content Include="HeatTransform.xslt" />
    <Content Include="Setup.Dorc.Cli.msi.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tools.DeployCopyEnvBuildCLI\Tools.DeployCopyEnvBuildCLI.csproj" />
    <ProjectReference Include="..\Tools.PostRestoreEndurCLI\Tools.PostRestoreEndurCLI.csproj" />
    <ProjectReference Include="..\Tools.PropertyValueCreationCLI\Tools.PropertyValueCreationCLI.csproj" />
    <ProjectReference Include="..\Tools.RequestCLI\Tools.RequestCLI.csproj" />
    <ProjectReference Include="..\Tools.EncryptionMigrationCLI\Tools.EncryptionMigrationCLI.csproj" />
  </ItemGroup>
  <!--
    Local-build fallback only — see the equivalent target in Setup.Dorc.wixproj
    for the full reasoning. CI runs src\InstallerPayload.proj first and passes
    DorcPayloadPrepublished=true, which skips this.
  -->
  <Target Name="PublishProjects" AfterTargets="BeforeResolveReferences"
          Condition="'$(DorcPayloadPrepublished)' != 'true'">
    <Exec Command="dotnet publish &quot;$(SolutionDir)Tools.DeployCopyEnvBuildCLI\Tools.DeployCopyEnvBuildCLI.csproj&quot; -c $(Configuration)" />
    <Exec Command="dotnet publish &quot;$(SolutionDir)Tools.PostRestoreEndurCLI\Tools.PostRestoreEndurCLI.csproj&quot; -c $(Configuration)" />
    <Exec Command="dotnet publish &quot;$(SolutionDir)Tools.PropertyValueCreationCLI\Tools.PropertyValueCreationCLI.csproj&quot; -c $(Configuration)" />
    <Exec Command="dotnet publish &quot;$(SolutionDir)Tools.RequestCLI\Tools.RequestCLI.csproj&quot; -c $(Configuration)" />
    <Exec Command="dotnet publish &quot;$(SolutionDir)Tools.EncryptionMigrationCLI\Tools.EncryptionMigrationCLI.csproj&quot; -c $(Configuration)" />
  </Target>
  <!--
    See Setup.Dorc.wixproj: a CI build with no Version would ship a package no
    environment could upgrade to, and would do it silently.
  -->
  <Target Name="EnsureBuildVersion" BeforeTargets="Build"
          Condition="'$(Version)' == '' and ('$(TF_BUILD)' != '' or '$(GITHUB_ACTIONS)' != '')">
    <Error Text="No Version property was supplied, so the package would be versioned $(DorcProductVersion). Pass /p:Version=&lt;build number&gt;." />
  </Target>
  <ItemGroup>
    <HarvestDirectory Include="$(ToolsDCEBDir)">
      <DirectoryRefId>DeployCopyEnvBuildDir</DirectoryRefId>
      <ComponentGroupName>ToolsDeployCopyEnvBuildComGroup</ComponentGroupName>
      <Transforms>$(MSBuildProjectDirectory)/HeatTransform.xslt</Transforms>
      <PreprocessorVariable>var.ToolsDCEBDir</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
    </HarvestDirectory>
    <HarvestDirectory Include="$(ToolsPREDir)">
      <DirectoryRefId>PostRestoreEndurDir</DirectoryRefId>
      <ComponentGroupName>ToolsPostRestoreEndurComGroup</ComponentGroupName>
      <Transforms>$(MSBuildProjectDirectory)/HeatTransform.xslt</Transforms>
      <PreprocessorVariable>var.ToolsPREDir</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
    </HarvestDirectory>
    <HarvestDirectory Include="$(ToolsPVCDir)">
      <DirectoryRefId>PropertyValueCreationDir</DirectoryRefId>
      <ComponentGroupName>ToolsPropertyValueCreationComGroup</ComponentGroupName>
      <Transforms>$(MSBuildProjectDirectory)/HeatTransform.xslt</Transforms>
      <PreprocessorVariable>var.ToolsPVCDir</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
    </HarvestDirectory>
    <HarvestDirectory Include="$(ToolsReqDir)">
      <DirectoryRefId>RequestDir</DirectoryRefId>
      <ComponentGroupName>ToolsRequestComGroup</ComponentGroupName>
      <Transforms>$(MSBuildProjectDirectory)/HeatTransform.xslt</Transforms>
      <PreprocessorVariable>var.ToolsReqDir</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
    </HarvestDirectory>
    <HarvestDirectory Include="$(ToolsEMDir)">
      <DirectoryRefId>EncryptionMigrationDir</DirectoryRefId>
      <ComponentGroupName>ToolsEncryptionMigrationComGroup</ComponentGroupName>
      <Transforms>$(MSBuildProjectDirectory)/HeatTransform.xslt</Transforms>
      <PreprocessorVariable>var.ToolsEMDir</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
    </HarvestDirectory>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixJsonFileExtension" Version="6.3.2" />
    <PackageReference Include="WixToolset.Heat" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="WixToolset.Sdk" Version="6.0.1" />
  <PropertyGroup>
    <PostBuildEvent>copy $(ProjectDir)%2a.msi.json $(TargetDir)\.</PostBuildEvent>
  </PropertyGroup>
</Project>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
	<?include Dependencies.wxi?>
	<Package Name="DOrc Command Line Tools" Language="1033" Version="$(var.ProductVersion)" Manufacturer="SEFE" UpgradeCode="{408AC1A6-9CD6-469A-9A03-46DA4473AD3C}" ProductCode="{A1584852-393C-43B0-9BA2-063316EAE3AD}">
		<Media Id="1" Cabinet="media1.cab" EmbedCab="yes" />

		<Feature Id="Tools" Title="Tools" Level="1">
			<ComponentRef Id="RemoveInstallRoot" />
			<ComponentRef Id="ToolsShare"/>
			<ComponentRef Id="RemoveToolsFolder"/>

			<ComponentRef Id="ToolsRequestConfigSetup"/>
			<ComponentGroupRef Id="ToolsRequestComGroup"/>

			<ComponentRef Id="DeployCopyEnvBuildConfigSetup"/>
			<ComponentGroupRef Id="ToolsDeployCopyEnvBuildComGroup"/>

			<ComponentRef Id="PostRestoreEndurConfigSetup"/>
			<ComponentGroupRef Id="ToolsPostRestoreEndurComGroup"/>

			<ComponentRef Id="PropertyValueCreationConfigSetup"/>
			<ComponentGroupRef Id="ToolsPropertyValueCreationComGroup"/>

			<ComponentRef Id="EncryptionMigrationConfigSetup"/>
			<ComponentGroupRef Id="ToolsEncryptionMigrationComGroup"/>
		</Feature>

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="DOrcFolder" Name="DOrc">
				<!--
					The install root is shared with the other DOrc packages and owned by
					none of them, so nothing here may delete recursively. Plain
					RemoveFolder removes a directory only when it is already empty, so
					every package can declare it and whichever is uninstalled last is the
					one that succeeds. Kept identical to the equivalent component in the
					other packages, deliberately.
				-->
				<Directory Id="INSTALLLOCATION" Name="Deploy">
					<Component Id="RemoveInstallRoot" Guid="{C991E435-A800-4198-BA16-E0800CD1170B}">
						<CreateFolder />
						<RemoveFile Id="Remove.Files" Directory="INSTALLLOCATION" Name="*.*" On="both" />
						<RemoveFolder Id="Remove.Folder" On="both" />
					</Component>
					<!-- Tools is owned outright by this package, so recursive cleanup is safe. -->
					<Directory Id="ToolsFolder" Name="Tools">
						<Component Id="RemoveToolsFolder" Guid="{BB22A06E-8C8D-46E6-BE8B-10B267CA5F7E}">
							<CreateFolder />
							<util:RemoveFolderEx Id="Remove.ToolsFolderEx" Property="ToolsFolder" On="both" />
							<RemoveFolder Id="Remove.ToolsFolder" On="both" />
						</Component>
						<Component Id="ToolsShare" Guid="{3EF3C439-2F64-4F75-8CAC-2627EEE9ECA3}" Bitness="always64">
							<CreateFolder />
							<util:User Id="Everyone" Name="Everyone" CreateUser="no" FailIfExists="no" RemoveOnUninstall="no" />
							<util:FileShare Id="CLITools" Description="DOrc CLI Tools" Name="CLITools">
								<util:FileSharePermission User="Everyone" GenericRead="yes" GenericExecute="yes" GenericWrite="no" />
							</util:FileShare>
						</Component>
						<Directory Id="RequestDir" Name="Request" />
						<Directory Id="DeployCopyEnvBuildDir" Name="DeployCopyEnvBuild" />
						<Directory Id="EndurConfigDir" Name="EndurConfig" />
						<Directory Id="PostRestoreEndurDir" Name="PostRestoreEndur" />
						<Directory Id="PropertyValueCreationDir" Name="PropertyValueCreation" />
						<Directory Id="EncryptionMigrationDir" Name="EncryptionMigration" />
					</Directory>
				</Directory>
			</Directory>
		</StandardDirectory>
	</Package>
</Wix>

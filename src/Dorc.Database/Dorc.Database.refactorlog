  <!--
    Reference-data tables move from the legacy dbo schema to the deploy schema and
    take the deploy column convention (docs/tag-schema-standardisation).

    These operations are what make the move data-preserving: SqlPackage reads them
    when it generates the deployment script and emits ALTER SCHEMA TRANSFER /
    sp_rename instead of diffing dbo.DATABASE against deploy.Database and deciding
    the latter is a brand new, empty table. A pre-deployment script cannot do this
    job — the script is generated from the pre-migration state of the target, so
    the generated CREATE TABLE would collide with whatever a pre-deploy rename had
    already produced.

    Order matters: move the schema first, then rename the table, then the columns,
    so each ElementName below names the object as the preceding operations left it.

    The table rename goes via a *RenameStage staging name because the model collation
    is case-insensitive (1033,CI): DacFx compares DATABASE to Database, finds them
    equal and skips a direct rename outright, leaving the physical table with its
    legacy upper-case name. Two hops through a name that differs by more than case
    are each a genuine change, so both are emitted. The staging name never survives
    the deployment script.
  -->
  <Operation Name="Move Schema" Key="6d26fd55-8f83-42ff-8e17-726da1a5eb9f" ChangeDateTime="08/10/2026 09:00:00">
    <Property Name="ElementName" Value="[dbo].[DATABASE]" />
    <Property Name="ElementType" Value="SqlTable" />
    <Property Name="NewSchema" Value="deploy" />
    <Property Name="IsNewSchemaExternal" Value="False" />
  </Operation>
  <Operation Name="Rename Refactor" Key="fa64201f-bc19-4d98-9a8e-f186d669e978" ChangeDateTime="08/10/2026 09:00:01">
    <Property Name="ElementName" Value="[deploy].[DATABASE]" />
    <Property Name="ElementType" Value="SqlTable" />
    <Property Name="ParentElementName" Value="[deploy]" />
    <Property Name="ParentElementType" Value="SqlSchema" />
    <Property Name="NewName" Value="DatabaseRenameStage" />
  </Operation>
  <Operation Name="Rename Refactor" Key="b1f0c4a2-6d3e-4c07-9f21-0a7e5b6c8d11" ChangeDateTime="08/10/2026 09:00:01">
    <Property Name="ElementName" Value="[deploy].[DatabaseRenameStage]" />
